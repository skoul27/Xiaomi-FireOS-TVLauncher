<?xml version="1.0" encoding="utf-8"?>
<!-- Key events, plus window changes from Amazon's launcher (to catch its home screen opening)
     and, for pay to play's guard, from Fire OS's Live TV player and settings apps. No window
     content, no gestures. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.amazon.tv.launcher,com.amazon.tv.livetv,com.amazon.tv.settings.v2,com.amazon.tv.settings.mediatek,com.amazon.tv.quicksettings,com.amazon.tv.quicksettings.ui,com.amazon.android.settings,com.amazon.tv.devicecontrolsettings,com.android.settings,com.android.tv.settings"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/shortcut_service_description"
    android:notificationTimeout="0" />
