<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Read-only connectivity state for the top bar's network indicator. No INTERNET permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets the long-press menu open the system uninstall dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Package visibility (API 30+): let us see apps exposing either launcher category. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- The settings screens the gear menu checks for before offering them. -->
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.APPLICATION_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DEVICE_INFO_SETTINGS" /></intent>
        <package android:name="com.amazon.tv.settings.v2" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Lets the system use this as the Home app. Fire OS routes Home to Amazon's
                 launcher while that is enabled; see RECOVERY.md. Pressing Home here
                 arrives as onNewIntent and resets the screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- A console's HDMI input, full screen, opened from the Consoles row. -->
        <activity
            android:name=".ConsoleActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Optional global shortcut: a color button brings the launcher to the front from any
             app. Key filtering only; the user turns it on under Settings > Accessibility. -->
        <service
            android:name=".ShortcutKeyService"
            android:exported="true"
            android:label="@string/shortcut_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shortcut_key_service" />
        </service>

        <!-- Lets adb copy the backup file in and out (Fire OS blocks adb from Android/data).
             Exported so the shell can reach it; the provider refuses every caller but adb. -->
        <provider
            android:name=".BackupFileProvider"
            android:authorities="com.shivam.tvlauncher.backup"
            android:exported="true" />
    </application>
</manifest>
